RewriteEngine On
RewriteBase /

# 1. SE FOR /api/ -> NÃO MEXER, deixa o PHP rodar
RewriteRule ^api/ - [L]

# 2. Se o arquivo ou pasta realmente existe, serve ele
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. Se não, é rota do React -> manda pra home
RewriteRule ^ index.html [L]