RewriteEngine On
RewriteBase /

# 0. Reforço explícito pras rotas de log de vídeo — a regra genérica
# "^api/ -" logo abaixo já devia bastar, mas isso aqui deixa essas duas
# rotas blindadas do fallback de SPA mesmo se a regra genérica for
# alterada/removida no futuro.
RewriteRule ^api/video-log\.php - [L]
RewriteRule ^api/ver-logs\.php - [L]

# 1. SE FOR /api/ -> NÃO MEXER, deixa o PHP rodar
RewriteRule ^api/ - [L]

# 1b. Link antigo do admin: /admin-meditacao -> /admin (301 de verdade,
# antes do fallback de SPA da regra 3, senão isso nunca dispara).
RewriteRule ^admin-meditacao/?$ /admin [R=301,L]

# 2. Se o arquivo ou pasta realmente existe, serve ele
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. Se não, é rota do React -> manda pra home
RewriteRule ^ index.html [L]